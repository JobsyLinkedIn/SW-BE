pipeline {
    agent any

    environment {
        IMAGE_NAME     = 'backend'
        REGISTRY       = 'docker.io'
        DOCKER_IMAGE   = "${REGISTRY}/${IMAGE_NAME}:latest"
        AZURE_SSH_KEY  = '/var/jenkins_home/.ssh/JOBSY-UBUNTU.pem'
        AZURE_SERVER_IP= '74.162.41.144'
        AZURE_USERNAME = 'kassem'
        REPO_URL       = 'git@github.com:JobsyLinkedIn/SW-BE.git'
        WORK_DIR       = '/home/kassem/SW-BE'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Prepare .env') {
            steps {
                // this will copy the env-file-jobsy credential into your workspace as ".env"
                withCredentials([file(credentialsId: 'env-file-jobsy', variable: 'ENV_FILE')]) {
                    sh '''
                        echo "Writing .env from Jenkins credential..."
                        cp "${ENV_FILE}" .env
                        chmod 600 .env
                    '''
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker-compose build backend'
            }
        }

        stage('Run Tests') {
            steps {
                sh 'docker-compose run --rm backend npm run test || echo "No tests defined"'
            }
        }

        stage('Push Docker Image') {
            // only on main
            when {
                expression { env.BRANCH_NAME == 'main' }
            }
            steps {
                withCredentials([usernamePassword(
                                  credentialsId: 'docker-hub-credentials',
                                  usernameVariable: 'DOCKER_USERNAME',
                                  passwordVariable: 'DOCKER_PASSWORD'
                                )]) {
                    sh '''
                        echo $DOCKER_PASSWORD | docker login -u $DOCKER_USERNAME --password-stdin
                        docker tag backend ${DOCKER_IMAGE}
                        docker push ${DOCKER_IMAGE}
                    '''
                }
            }
        }

        stage('Deploy to Azure') {
            steps {
                sh """
                    ssh -i ${AZURE_SSH_KEY} ${AZURE_USERNAME}@${AZURE_SERVER_IP} \\
                    'if [ -d "${WORK_DIR}" ]; then
                         cd "${WORK_DIR}" && git pull origin main && docker-compose down && \\
                         docker ps -aq -f name=mongo | xargs -r docker rm -f && \\
                         docker-compose up -d
                     else
                         git clone ${REPO_URL} ${WORK_DIR} && cd ${WORK_DIR} && docker-compose up -d
                     fi'
                """
            }
        }
    }

    post {
        success {
            echo 'Build and deployment completed successfully!'
        }
        failure {
            echo 'Build or deployment failed!'
        }
    }
}
