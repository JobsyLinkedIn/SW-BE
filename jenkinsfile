pipeline {
    agent any

    environment {
        IMAGE_NAME      = 'backend'
        REGISTRY        = 'docker.io'
        DOCKER_IMAGE    = "${REGISTRY}/${IMAGE_NAME}:latest"
        AZURE_SERVER_IP = '74.162.41.144'
        AZURE_USERNAME  = 'kassem'
        REPO_URL        = 'git@github.com:JobsyLinkedIn/SW-BE.git'
        WORK_DIR        = '/home/kassem/SW-BE'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Prepare .env') {
            steps {
                withCredentials([string(credentialsId: 'env-vars-jobsy', variable: 'ENV_CONTENTS')]) {
                    // Write .env locally
                    sh '''#!/bin/bash
                        echo "Writing .env from Jenkins secret..."
                        printf "%s\\n" "$ENV_CONTENTS" > .env
                        chmod 600 .env
                    '''

                    // Copy .env to Azure server via SCP using SSH credentials
                    sshagent(['azure-server-ssh']) {
                        sh '''
                            echo "Transferring .env to Azure server..."
                            scp -o StrictHostKeyChecking=no .env ${AZURE_USERNAME}@${AZURE_SERVER_IP}:${WORK_DIR}/.env
                        '''
                    }
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker-compose build backend'
            }
        }

        stage('Run Tests') {
            steps {
                sh 'echo "No tests defined"'
            }
        }

        stage('Push Docker Image') {
            when {
                expression { env.BRANCH_NAME == 'main' }
            }
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'docker-hub-credentials',
                    usernameVariable: 'DOCKER_USERNAME',
                    passwordVariable: 'DOCKER_PASSWORD'
                )]) {
                    sh '''#!/bin/bash
                        echo "$DOCKER_PASSWORD" | docker login -u "$DOCKER_USERNAME" --password-stdin
                        docker tag backend ${DOCKER_IMAGE}
                        docker push ${DOCKER_IMAGE}
                    '''
                }
            }
        }

        stage('Deploy to Azure') {
            steps {
                sshagent(['azure-server-ssh']) {
                    sh """#!/bin/bash
                        echo "Deploying to Azure server..."
                        ssh -o StrictHostKeyChecking=no ${AZURE_USERNAME}@${AZURE_SERVER_IP} '
                            set -e
                            if [ -d "${WORK_DIR}" ]; then
                                echo "Directory exists, pulling latest changes..."
                                cd "${WORK_DIR}"
                                git pull origin main

                                echo "Rebuilding backend..."
                                docker-compose build backend

                                echo "Restarting backend container..."
                                docker-compose up -d backend
                            else
                                echo "Cloning repository and starting services..."
                                git clone ${REPO_URL} ${WORK_DIR}
                                cd ${WORK_DIR}
                                docker-compose up -d
                            fi
                        '
                    """
                }
            }
        }
    }

    post {
        success {
            echo ' Build and deployment completed successfully!'
        }
        failure {
            echo ' Build or deployment failed!'
        }
    }
}
