pipeline {
    agent any

    environment {
        IMAGE_NAME = 'backend'
        REGISTRY = 'docker.io'  // Change this to your Docker registry if you're using one
        DOCKER_IMAGE = "${REGISTRY}/${IMAGE_NAME}:latest"
        AZURE_SSH_KEY = '/var/jenkins_home/.ssh/JOBSY-UBUNTU.pem'  // Path to your private key in Jenkins container
        AZURE_SERVER_IP = '74.162.41.144'  // Azure server IP
        AZURE_USERNAME = 'kassem'  // SSH username
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    sh 'docker-compose build backend'
                }
            }
        }

        stage('Run Tests') {
            when {
                expression {
                    // Check if "test" script in package.json contains a valid testing framework command (e.g., jest)
                    def packageJson = readFile('package.json')
                    return packageJson.contains('"test": "jest')  // Or any other valid testing framework command
                }
            }
            steps {
                script {
                    sh 'docker-compose run backend npm run test'
                }
            }
        }

        stage('Push Docker Image') {
            when {
                branch 'main'
            }
            steps {
                script {
                    sh 'docker tag backend ${DOCKER_IMAGE}'
                    sh 'docker push ${DOCKER_IMAGE}'
                }
            }
        }

        stage('Deploy to Azure') {
            when {
                branch 'main'
            }
            steps {
                script {
                    // SSH into the Azure server and pull the new Docker image
                    sh """
                    ssh -i ${AZURE_SSH_KEY} ${AZURE_USERNAME}@${AZURE_SERVER_IP} "
                        docker pull ${DOCKER_IMAGE}
                        docker-compose up -d
                    "
                    """
                }
            }
        }
    }

    post {
        success {
            echo 'Build and deployment completed successfully!'
        }

        failure {
            echo 'Build or deployment failed!'
        }
    }
}
